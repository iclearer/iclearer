{
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/refund",
      "destination": "/refund.html"
    },
    {
      "source": "/refund-policy",
      "destination": "/refund.html"
    },
    {
      "source": "/guides",
      "destination": "/guides/index.html"
    },
    {
      "source": "/guides/:slug",
      "destination": "/guides/:slug.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "iclearer.vercel.app"
        }
      ],
      "destination": "https://www.iclearer.com/:path*",
      "permanent": true
    },
    {
      "source": "/about.html",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/about-us",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/install.html",
      "destination": "/#install",
      "permanent": false
    },
    {
      "source": "/terms-of-service",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/refund-policy.html",
      "destination": "/refund",
      "permanent": true
    },
    {
      "source": "/guides/index.html",
      "destination": "/guides",
      "permanent": true
    },
    {
      "source": "/guides/(.*)\\.html",
      "destination": "/guides/$1",
      "permanent": true
    }
  ]
}

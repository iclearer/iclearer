# Company Supabase (iClearer project)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Optional: Postgres URI to apply SQL via supabase/apply.sh
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Website (Vite)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SITE_URL=https://iclearer.com

# License signing (Ed25519) — generate once; public key is also embedded in the Mac app
LICENSE_SIGNING_PRIVATE_KEY_B64=
LICENSE_SIGNING_PUBLIC_KEY_B64=

# Resend (transactional: license key + sign-in link)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=iClearer <licenses@iclearer.com>
SITE_URL=https://iclearer.com

# Offline grace (days)
GRACE_DAYS_OK=24
GRACE_DAYS_WARN=6

# Paddle Billing — use LIVE values for production (never commit real secrets)
# Sandbox: pdl_sdbx_apikey_… / test_… client token / sandbox-api.paddle.com
# Live:    pdl_live_apikey_… / live_… client token / api.paddle.com
PADDLE_API_KEY=pdl_live_apikey_...
PADDLE_WEBHOOK_SECRET=pdl_ntfset_...
PADDLE_ENV=live
# Webhook reverse map: live price id → plan + macs (1/2/5 Mac matrix)
PADDLE_PRICE_MAP_JSON={"pri_YEARLY_1":{"plan":"yearly","macs":1},"pri_YEARLY_2":{"plan":"yearly","macs":2},"pri_YEARLY_5":{"plan":"yearly","macs":5},"pri_MONTHLY_1":{"plan":"monthly","macs":1},"pri_MONTHLY_2":{"plan":"monthly","macs":2},"pri_MONTHLY_5":{"plan":"monthly","macs":5},"pri_ONCE_1":{"plan":"once","macs":1},"pri_ONCE_2":{"plan":"once","macs":2},"pri_ONCE_5":{"plan":"once","macs":5}}
# Frontend: live client-side token + checkout price map (must match app Pricing.swift)
VITE_PADDLE_CLIENT_TOKEN=live_...
VITE_PADDLE_PRICE_MAP_JSON={"yearly:1":"pri_YEARLY_1","yearly:2":"pri_YEARLY_2","yearly:5":"pri_YEARLY_5","monthly:1":"pri_MONTHLY_1","monthly:2":"pri_MONTHLY_2","monthly:5":"pri_MONTHLY_5","once:1":"pri_ONCE_1","once:2":"pri_ONCE_2","once:5":"pri_ONCE_5"}
# See docs/paddle-live-mapping.json for live price IDs.

# Company Supabase (iClearer project)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Optional: Postgres URI to apply SQL via supabase/apply.sh
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Website (Vite)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SITE_URL=https://iclearer.com

# License signing (Ed25519) — generate once; public key is also embedded in the Mac app
LICENSE_SIGNING_PRIVATE_KEY_B64=
LICENSE_SIGNING_PUBLIC_KEY_B64=

# Resend (transactional: license key + sign-in link)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=iClearer <licenses@iclearer.com>
SITE_URL=https://www.iclearer.com

# Offline grace (days)
GRACE_DAYS_OK=24
GRACE_DAYS_WARN=6

# Creem Merchant of Record (https://www.creem.io/)
# Test: creem_test_… → test-api.creem.io | Live: creem_… → api.creem.io
# Create products with: node scripts/creem-seed-products.mjs
CREEM_API_KEY=creem_test_...
CREEM_WEBHOOK_SECRET=
# plan:macs → product id (used by license-api create_checkout)
CREEM_PRODUCT_MAP_JSON={"yearly:1":"prod_xxx","yearly:2":"prod_xxx","yearly:5":"prod_xxx","monthly:1":"prod_xxx","monthly:2":"prod_xxx","monthly:5":"prod_xxx","once:1":"prod_xxx","once:2":"prod_xxx","once:5":"prod_xxx"}
# product id → {plan,macs} (used by creem-webhook fallback; metadata usually enough)
CREEM_PRODUCT_REVERSE_JSON={"prod_xxx":{"plan":"yearly","macs":1}}

# Company Supabase (iClearer project)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Optional: Postgres URI to apply SQL via supabase/apply.sh
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Website (Vite)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SITE_URL=https://iclearer.com

# License signing (Ed25519) — generate once; public key is also embedded in the Mac app
LICENSE_SIGNING_PRIVATE_KEY_B64=
LICENSE_SIGNING_PUBLIC_KEY_B64=

# Resend (transactional: license key + sign-in link)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=iClearer <licenses@iclearer.com>
SITE_URL=https://iclearer.com

# Offline grace (days)
GRACE_DAYS_OK=24
GRACE_DAYS_WARN=6

# Paddle Billing (optional until payments go live)
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENV=sandbox
PADDLE_PRICE_MAP_JSON={"pri_xxx":{"plan":"yearly","macs":1}}
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_PRICE_MAP_JSON={"yearly:1":"pri_xxx","monthly:1":"pri_yyy","once:1":"pri_zzz"}
